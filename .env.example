# Copy to .env (never commit .env). The server reads these from the environment.
HOST=127.0.0.1
PORT=8080

# Optional AI contextual review. Off unless both are set. The key stays on the server.
# KHMERPROOF_AI=on
# ANTHROPIC_API_KEY=
# KHMERPROOF_AI_MODEL=claude-opus-5-5

# Optional paths when the tools are not on PATH
# CHROMIUM_PATH=
# PDFTOTEXT_PATH=

# Set to "off" to disable the access log (it never contains document text)
# KHMERPROOF_LOG=on
